{
  "info": {
    "name": "Iris ML Service",
    "description": "Test requests for the FastAPI Iris classifier. Change the base_url variable to point to Cloud Run.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": { "method": "GET", "url": "{{base_url}}/" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status is 200', () => pm.response.to.have.status(200));",
        "pm.test('status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
      ] } }]
    },
    {
      "name": "Predict (POST) - setosa",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"sepal_length\": 5.1,\n  \"sepal_width\": 3.4,\n  \"petal_length\": 1.3,\n  \"petal_width\": 0.2\n}" },
        "url": "{{base_url}}/predict"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status is 200', () => pm.response.to.have.status(200));",
        "pm.test('species is setosa', () => pm.expect(pm.response.json().species).to.eql('setosa'));"
      ] } }]
    },
    {
      "name": "Predict (POST) - versicolor",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"sepal_length\": 5.9,\n  \"sepal_width\": 3.0,\n  \"petal_length\": 4.2,\n  \"petal_width\": 1.5\n}" },
        "url": "{{base_url}}/predict"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('species is versicolor', () => pm.expect(pm.response.json().species).to.eql('versicolor'));"
      ] } }]
    },
    {
      "name": "Predict (POST) - virginica",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"sepal_length\": 6.7,\n  \"sepal_width\": 3.0,\n  \"petal_length\": 5.2,\n  \"petal_width\": 2.3\n}" },
        "url": "{{base_url}}/predict"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('species is virginica', () => pm.expect(pm.response.json().species).to.eql('virginica'));"
      ] } }]
    },
    {
      "name": "Predict (GET, values in URL)",
      "request": { "method": "GET", "url": "{{base_url}}/api/predict/5.1/3.4/1.3/0.2" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status is 200', () => pm.response.to.have.status(200));",
        "pm.test('prediction is 0', () => pm.expect(pm.response.json().prediction).to.eql(0));"
      ] } }]
    },
    {
      "name": "Invalid input (missing field) - expect 422",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"sepal_length\": 5.1\n}" },
        "url": "{{base_url}}/predict"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
        "pm.test('status is 422', () => pm.response.to.have.status(422));"
      ] } }]
    }
  ]
}
