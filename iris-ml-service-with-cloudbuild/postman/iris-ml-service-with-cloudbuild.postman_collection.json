{
  "info": {
    "name": "Iris ML Service with Cloud Build",
    "description": "After uploading a CSV to the bucket, call GET / to see which model the API serves (model_uri changes after each training).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Which model is served?",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict - setosa",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/predict",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sepal_length\": 5.1,\n  \"sepal_width\": 3.4,\n  \"petal_length\": 1.3,\n  \"petal_width\": 0.2\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Iris-setosa', () => pm.expect(pm.response.json().species).to.eql('Iris-setosa'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Predict - virginica",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/predict",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sepal_length\": 6.7,\n  \"sepal_width\": 3.0,\n  \"petal_length\": 5.2,\n  \"petal_width\": 2.3\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Iris-virginica', () => pm.expect(pm.response.json().species).to.eql('Iris-virginica'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid input - expect 422",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/predict",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sepal_length\": 5.1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 422', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ]
    }
  ]
}